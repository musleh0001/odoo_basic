<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View-->
    <record id="hospital_patient_readonly_view_tree" model="ir.ui.view">
        <field name="name">hospital.patient.readonly.view.tree</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <tree string="Patients" create="false">
                <field name="name" />
                <field name="date_of_birth" optional="show" />
                <field name="gender" optional="hide" />
            </tree>
        </field>
    </record>

    <!-- Form View-->
    <record id="hospital_patient_readonly_view_form" model="ir.ui.view">
        <field name="name">hospital.patient.readonly.view.form</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <form string="Patient" create="false" edit="false" delete="false">
                <sheet>
                    <h1>
                        <field name="name" placeholder="Patient Name" />
                    </h1>

                    <group>
                        <group>
                            <field name="date_of_birth" />
                        </group>

                        <group>
                            <field name="gender" widget="radio" />
                        </group>
                    </group>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="hospital_patient_readonly_action" model="ir.actions.act_window">
        <field name="name">View Patients</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids"
            eval="[Command.clear(),
            (0,0,{'view_mode':'tree', 'view_id': ref('hospital_patient_readonly_view_tree')}),
            (0,0,{'view_mode':'form', 'view_id': ref('hospital_patient_readonly_view_form')})]" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No patients found. Only viewing is allowed.
            </p>

        </field>
    </record>

</odoo>