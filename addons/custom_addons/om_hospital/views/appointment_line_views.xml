<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View-->
    <record id="hospital_appointment_line_view_tree" model="ir.ui.view">
        <field name="name">hospital.appointment.line.view.tree</field>
        <field name="model">hospital.appointment.line</field>
        <field name="arch" type="xml">
            <tree string="Appointment Line" editable="top">
                <field name="appointment_id" />
                <field name="product_id" />
                <field name="qty" />
            </tree>
        </field>
    </record>


    <!-- Actions -->
    <record id="hospital_appointment_line_action" model="ir.actions.act_window">
        <field name="name">Appointment Line</field>
        <field name="res_model">hospital.appointment.line</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new appointment line
            </p>
        </field>
    </record>

</odoo>